// Uploads the built course site (.vitepress/dist) to the "aith" Worker as static assets,
// with a small Worker script (worker/index.ts) that proxies Plausible analytics.
// Run through `make deploy`. Terraform (deploy/infra/cloudflare) owns the Worker and its
// custom domain, so no routes are listed here: wrangler leaves unlisted domains alone.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aith",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.ts",
  // Match Terraform: serve only on aith.aijutsu.dev, not *.workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./.vitepress/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Only the analytics paths run the script. Every other request is served straight from
    // the assets, as before, and costs no Worker invocation.
    "run_worker_first": ["/js/p.js", "/api/e"]
  },
  // Analytics (docs/system/analytics.md). This site reports into the "aijutsu.dev" site in
  // Plausible, which covers every aijutsu.dev subdomain; the course site is the "Hostname"
  // filter there. So PLAUSIBLE_SCRIPT is that site's tracker (Site Settings → Installation),
  // the same one aijutsu.dev itself loads: its domain is built into the file. Either the
  // path or the bare id works. Empty turns analytics off.
  "vars": {
    "PLAUSIBLE_UPSTREAM": "https://ponzu.aijutsu.dev",
    "PLAUSIBLE_SCRIPT": "/js/pa-eRO2lk6xypVEFuCArhX6m.js"
  }
}
